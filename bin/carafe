#!/usr/bin/env bash
# carafe — минимальный запускатель Windows-игр на macOS: Wine + D3DMetal + steamcmd.
set -euo pipefail

CARAFE_HOME="${CARAFE_HOME:-$HOME/Library/Application Support/carafe}"
ENGINES="$CARAFE_HOME/engines"
BOTTLES="$CARAFE_HOME/bottles"
GAMES="$CARAFE_HOME/games"
STEAMCMD_DIR="$CARAFE_HOME/steamcmd"

# Движок по умолчанию: сборка Wine от Gcenx с D3DMetal из Apple Game Porting Toolkit 3.0.
ENGINE_NAME="gptk-3.0-3"
ENGINE_URL="https://github.com/Gcenx/game-porting-toolkit/releases/download/Game-Porting-Toolkit-3.0-3/game-porting-toolkit-3.0-3.tar.xz"
ENGINE_SHA256="d377683937340f914823dbb2e1252b329cbf834ff58907d0293db8cebf0e392e"
STEAMCMD_URL="https://steamcdn-a.akamaihd.net/client/installer/steamcmd_osx.tar.gz"

CARAFE_SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Мост Steamworks живёт в движке soju (bin/soju-bridge): по умолчанию — checkout рядом с carafe.
SOJU_SRC="${CARAFE_SOJU:-$(cd "$CARAFE_SRC/.." && pwd)/soju}"
BRIDGES="$CARAFE_HOME/bridge"

die() { echo "carafe: $*" >&2; exit 1; }
log() { echo "==> $*" >&2; }

usage() {
  cat <<'EOF'
Использование:
  carafe engine install            скачать и распаковать Wine + D3DMetal
  carafe bottle create [NAME]      создать префикс Wine (по умолчанию: default)
  carafe steam login USER          войти в steamcmd (пароль и Steam Guard вводишь сам)
  carafe game install APPID USER   скачать Windows-сборку игры через steamcmd
  carafe game import APPID [DIR]   забрать depot, скачанный консолью Steam (download_depot)
  carafe game run APPID [ARGS...]  запустить игру (exe ищется в папке игры)
  carafe bridge build APPID|DLL    собрать мост в Steam для Mac (ачивки, лидерборды) — из soju
  carafe bridge test APPID|DLL     проверить мост на Spacewar (480) против нативного Steam
  carafe cloud status|pull|push APPID  сейвы со Steam Cloud (game run делает pull/push сам)
  carafe run EXE [ARGS...]         запустить произвольный .exe в префиксе
  carafe wine [ARGS...]            вызвать wine с окружением префикса (winecfg и т. п.)

Переменные: CARAFE_BOTTLE (префикс, default), CARAFE_EXE (exe игры вручную),
            CARAFE_HUD=1 (Metal HUD с FPS), CARAFE_BRIDGE=0 (запуск без моста).
            CARAFE_ENGINE_DIR (свой движок, например dist/soju-engine из soju),
            CARAFE_SOJU (checkout soju, по умолчанию ../soju рядом с carafe).
EOF
}

# CARAFE_ENGINE_DIR — свой движок вместо скачанного, например собранный soju (dist/soju-engine).
engine_dir() { echo "${CARAFE_ENGINE_DIR:-$ENGINES/$ENGINE_NAME}"; }

wine_bin() {
  local d; d="$(engine_dir)"
  [[ -d "$d" ]] || die "движок не установлен: carafe engine install"
  local w
  # bin/soju — wine движка soju с его настройками (msync, D3DMetal).
  for name in soju wine64 wine; do
    w="$(find "$d" -type f -path "*/bin/$name" -perm -u+x 2>/dev/null | head -1)"
    [[ -n "$w" ]] && { echo "$w"; return; }
  done
  die "не нашёл bin/wine в $d"
}

wine_env() {
  local bottle="${CARAFE_BOTTLE:-default}"
  export WINEPREFIX="$BOTTLES/$bottle"
  export WINEDEBUG="${WINEDEBUG:--all}"
  export WINEMSYNC="${WINEMSYNC:-1}"
  export WINEESYNC="${WINEESYNC:-1}"
  [[ "${CARAFE_HUD:-0}" == 1 ]] && export MTL_HUD_ENABLED=1
  local bin; bin="$(dirname "$(wine_bin)")"
  export PATH="$bin:$PATH"
}

cmd_engine_install() {
  local dl="$ENGINES/dl" tarball="$ENGINES/dl/${ENGINE_URL##*/}"
  mkdir -p "$dl"
  if [[ ! -f "$tarball" ]]; then
    log "качаю движок ${ENGINE_URL##*/}"
    curl -fL --retry 5 -C - -o "$tarball.part" "$ENGINE_URL"
    mv "$tarball.part" "$tarball"
  fi
  echo "$ENGINE_SHA256  $tarball" | shasum -a 256 -c - >/dev/null || die "sha256 архива не совпал"
  local d; d="$(engine_dir)"
  rm -rf "$d.tmp" && mkdir -p "$d.tmp"
  log "распаковываю в $d"
  tar -xJf "$tarball" -C "$d.tmp"
  # Карантин macOS блокирует запуск скачанных бинарников.
  xattr -dr com.apple.quarantine "$d.tmp" 2>/dev/null || true
  rm -rf "$d" && mv "$d.tmp" "$d"
  log "готово: $(wine_bin)"
}

cmd_bottle_create() {
  CARAFE_BOTTLE="${1:-${CARAFE_BOTTLE:-default}}"
  wine_env
  log "создаю префикс $WINEPREFIX"
  mkdir -p "$WINEPREFIX"
  "$(wine_bin)" wineboot --init
  # Windows 10 — то, что ждут современные Unity-игры.
  "$(wine_bin)" reg add 'HKCU\Software\Wine' /v Version /d win10 /f >/dev/null
  wineserver -w
  log "префикс готов"
}

ensure_steamcmd() {
  if [[ ! -x "$STEAMCMD_DIR/steamcmd.sh" ]]; then
    log "качаю steamcmd от Valve"
    mkdir -p "$STEAMCMD_DIR"
    curl -fsSL -o "$STEAMCMD_DIR/steamcmd_osx.tar.gz" "$STEAMCMD_URL"
    tar -xzf "$STEAMCMD_DIR/steamcmd_osx.tar.gz" -C "$STEAMCMD_DIR"
    rm "$STEAMCMD_DIR/steamcmd_osx.tar.gz"
  fi
}

cmd_steam_login() {
  local user="${1:?нужен логин Steam}"
  ensure_steamcmd
  "$STEAMCMD_DIR/steamcmd.sh" +login "$user" +quit
}

cmd_game_install() {
  local appid="${1:?нужен APPID}" user="${2:?нужен логин Steam}"
  ensure_steamcmd
  mkdir -p "$GAMES/$appid"
  "$STEAMCMD_DIR/steamcmd.sh" \
    +@sSteamCmdForcePlatformType windows \
    +force_install_dir "$GAMES/$appid" \
    +login "$user" \
    +app_update "$appid" validate \
    +quit
  # Steamworks внутри игры ищет appid рядом с exe, когда Steam-клиент не запущен.
  echo "$appid" > "$GAMES/$appid/steam_appid.txt"
}

# Обходы того, чего нет в Wine 7.7 из GPTK. Идемпотентно, вызывается перед запуском.
apply_quirks() {
  local dir="$1" wine_dlls; wine_dlls="$(dirname "$(dirname "$(wine_bin)")")/lib/wine/x86_64-windows"
  # IL2CPP-сборки Unity импортируют apiset, которого нет; функция живёт в wintypes.dll.
  local robuf="api-ms-win-core-winrt-robuffer-l1-1-0.dll"
  if [[ -f "$dir/GameAssembly.dll" && ! -f "$dir/$robuf" ]] && grep -aq "$robuf" "$dir/GameAssembly.dll"; then
    log "quirk: $robuf → wintypes.dll"
    cp "$wine_dlls/wintypes.dll" "$dir/$robuf"
  fi
  # Плагин Rewired для Windows.Gaming.Input падает без WinRT; без него Rewired берёт XInput/Raw Input.
  local wgi
  while IFS= read -r wgi; do
    log "quirk: отключаю ${wgi#"$dir"/}"
    mkdir -p "$dir/.carafe-disabled"
    mv "$wgi" "$dir/.carafe-disabled/"
  done < <(find "$dir" -path '*/Plugins/x86_64/*' -iname 'Rewired_WindowsGamingInput.dll' 2>/dev/null)
}

# Забрать игру, скачанную основным Steam-клиентом через консоль (download_depot).
cmd_game_import() {
  local appid="${1:?нужен APPID}" src="${2:-}"
  if [[ -z "$src" ]]; then
    src="$(find "$HOME/Library/Application Support/Steam" -type d -path "*/steamapps/content/app_$appid/depot_*" -maxdepth 8 2>/dev/null | head -1)"
    [[ -n "$src" ]] || die "не нашёл app_$appid в steamapps/content — скачай depot через консоль Steam или укажи папку"
  fi
  [[ -d "$src" ]] || die "нет папки $src"
  log "переношу $src → $GAMES/$appid"
  mkdir -p "$GAMES/$appid"
  rsync -a "$src/" "$GAMES/$appid/"
  echo "$appid" > "$GAMES/$appid/steam_appid.txt"
  log "готово, удалить исходник можно руками: $src"
}

find_game_exe() {
  local dir="$1"
  [[ -n "${CARAFE_EXE:-}" ]] && { echo "$dir/$CARAFE_EXE"; return; }
  # Самый крупный exe верхнего уровня, кроме служебных.
  find "$dir" -maxdepth 1 -iname '*.exe' ! -iname 'UnityCrashHandler*' ! -iname '*setup*' ! -iname '*redist*' \
    -exec stat -f '%z %N' {} + 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}

cmd_run() {
  local exe="${1:?нужен путь к exe}"; shift
  [[ -f "$exe" ]] || die "нет файла $exe"
  wine_env
  [[ -d "$WINEPREFIX" ]] || cmd_bottle_create "${CARAFE_BOTTLE:-default}"
  cd "$(dirname "$exe")"
  exec "$(wine_bin)" "$(basename "$exe")" "$@"
}

# Оригинальный steam_api64.dll игры: на месте или уже убранный мостом.
steam_api_orig() {
  local dir="$1" f
  f="$(find "$dir" -path '*/Plugins/x86_64/steam_api64.dll' 2>/dev/null | head -1)"
  [[ -n "$f" ]] || f="$(find "$dir" -maxdepth 1 -name steam_api64.dll 2>/dev/null | head -1)"
  [[ -n "$f" ]] || return 1
  if [[ -f "$dir/.carafe-disabled/steam_api64.dll" ]]; then
    echo "$f|$dir/.carafe-disabled/steam_api64.dll"
  else
    echo "$f|$f"
  fi
}

soju_bridge() {
  [[ -x "$SOJU_SRC/bin/soju-bridge" ]] || die "нужен soju: git clone https://github.com/userTrv/soju рядом с carafe (или CARAFE_SOJU)"
  "$SOJU_SRC/bin/soju-bridge" "$@"
}

# Оригинальный steam_api64.dll: игры по APPID или файл по пути (проверить мост на SDK без игры).
bridge_source_dll() {
  local arg="${1:?нужен APPID или путь к steam_api64.dll}" pair
  if [[ -f "$arg" ]]; then echo "$arg"; return; fi
  pair="$(steam_api_orig "$GAMES/$arg")" || die "в игре нет steam_api64.dll — мост не нужен"
  echo "${pair##*|}"
}

cmd_bridge_build() {
  local orig sha
  orig="$(bridge_source_dll "${1:-}")"
  sha="$(shasum -a 256 "$orig" | cut -d' ' -f1)"
  soju_bridge build "$orig" "$BRIDGES/$sha" >/dev/null
  log "мост готов: $BRIDGES/$sha"
}

# Поставить DLL моста (или вернуть оригинал). Печатает каталог моста, если он включён.
apply_bridge() {
  local dir="$1" pair live orig sha
  pair="$(steam_api_orig "$dir")" || return 0
  live="${pair%%|*}" orig="${pair##*|}"
  sha="$(shasum -a 256 "$orig" | cut -d' ' -f1)"
  local b="$BRIDGES/$sha"
  if [[ "${CARAFE_BRIDGE:-1}" == 0 || ! -x "$b/soju-steamd" ]]; then
    if [[ "$orig" != "$live" ]]; then
      log "мост выключен: возвращаю оригинальный steam_api64.dll"
      cp "$orig" "$live"
    fi
    return 0
  fi
  if [[ "$orig" == "$live" ]]; then
    mkdir -p "$dir/.carafe-disabled"
    cp "$live" "$dir/.carafe-disabled/steam_api64.dll"
  fi
  cmp -s "$b/steam_api64.dll" "$live" || cp "$b/steam_api64.dll" "$live"
  echo "$b"
}

# Проверка моста на Spacewar (480) против нативного Steam — в soju, на его движке.
cmd_bridge_test() { soju_bridge test "$(bridge_source_dll "${1:-}")"; }

# Правила Auto-Cloud игры (ufs/savefiles из appinfo) → строки ROOT:PATH:PATTERN:RECURSIVE.
cloud_rules() {
  local appid="$1" cache="$GAMES/$1/.carafe-ufs"
  if [[ ! -s "$cache" ]]; then
    ensure_steamcmd
    "$STEAMCMD_DIR/steamcmd.sh" +login anonymous +app_info_print "$appid" +quit 2>/dev/null |
      # VDF: глубина по скобкам; в строке "ключ" "значение" это поля 2 и 4 при разделителе-кавычке.
      awk -F'"' '
        $2 == "savefiles" && depth == 0 { want = 1; next }
        want && /{/ { depth++; if (depth == 2) { root = path = pat = ""; rec = 0 }; next }
        want && /}/ { if (depth == 2 && root != "") print root ":" path ":" pat ":" rec
                      depth--; if (depth == 0) want = 0; next }
        want && depth == 2 && $2 == "root" { root = $4 }
        want && depth == 2 && $2 == "path" { path = $4 }
        want && depth == 2 && $2 == "pattern" { pat = $4 }
        want && depth == 2 && $2 == "recursive" { rec = $4 }
      ' > "$cache.tmp" || true
    mv "$cache.tmp" "$cache"
  fi
  cat "$cache"
}

# Синхронизация сейвов со Steam Cloud через Steam для Mac. mode: status|pull|push.
cloud_sync() {
  local mode="$1" appid="$2" pair orig sha
  pair="$(steam_api_orig "$GAMES/$appid")" || die "в игре нет steam_api64.dll — облака у неё нет"
  orig="${pair##*|}"
  sha="$(shasum -a 256 "$orig" | cut -d' ' -f1)"
  local steamd="$BRIDGES/$sha/soju-steamd"
  [[ -x "$steamd" ]] || die "сначала собери мост: carafe bridge build $appid"
  local users="$BOTTLES/${CARAFE_BOTTLE:-default}/drive_c/users" u
  u="$(find "$users" -mindepth 1 -maxdepth 1 -type d ! -name Public | head -1)"
  [[ -n "$u" ]] || die "в префиксе нет пользователя"
  local args=(cloud "$mode"
    --state "$GAMES/$appid/.carafe-cloud-state" --backup "$CARAFE_HOME/backups/$appid"
    --root "WinAppDataLocalLow=$u/AppData/LocalLow" --root "WinAppDataLocal=$u/AppData/Local"
    --root "WinAppDataRoaming=$u/AppData/Roaming" --root "WinMyDocuments=$u/Documents"
    --root "WinSavedGames=$u/Saved Games" --root "gameinstall=$GAMES/$appid")
  local r n=0
  while IFS= read -r r; do [[ -n "$r" ]] && { args+=(--rule "$r"); n=$((n + 1)); }; done < <(cloud_rules "$appid")
  [[ $n -gt 0 ]] || { log "у игры нет правил Auto-Cloud — синхронизировать нечего"; return 0; }
  log "Steam Cloud: $mode"
  SteamAppId="$appid" "$steamd" "${args[@]}"
}

cmd_game_run() {
  local appid="${1:?нужен APPID}"; shift
  local exe; exe="$(find_game_exe "$GAMES/$appid")"
  [[ -n "$exe" ]] || die "не нашёл exe в $GAMES/$appid (задай CARAFE_EXE)"
  apply_quirks "$GAMES/$appid"
  local bridge; bridge="$(apply_bridge "$GAMES/$appid")"
  if [[ -z "$bridge" ]]; then
    log "запускаю $exe"
    cmd_run "$exe" "$@"
  fi

  # Облако до запуска: игра должна увидеть свежие сейвы. Ошибка синхронизации не мешает играть.
  local cloud="${CARAFE_CLOUD:-1}"
  if [[ "$cloud" == 1 ]] && ! cloud_sync pull "$appid"; then
    log "Steam Cloud: не удалось скачать сейвы — играю с локальными, выгружать после игры не буду"
    cloud=0
  fi

  log "запускаю $exe"
  local rc=0
  # Хелпер моста живёт, пока игра не отключится от Steam: soju-bridge exec ждёт и его,
  # а не только лаунчер wine, который может выйти раньше игры.
  SOJU_BRIDGE_LOG="$CARAFE_HOME/bridge-$appid.log" soju_bridge exec "$bridge" "$appid" \
    "$CARAFE_SRC/bin/carafe" run "$exe" "$@" || rc=$?
  # Хелпер выходит, когда игра отключилась, — значит, сейвы уже на диске.
  if [[ "$cloud" == 1 ]]; then
    cloud_sync push "$appid" || log "Steam Cloud: выгрузка не удалась — повтори: carafe cloud push $appid"
  fi
  return "$rc"
}

cmd_wine() { wine_env; exec "$(wine_bin)" "$@"; }

case "${1:-}" in
  engine) [[ "${2:-}" == install ]] || { usage; exit 1; }; cmd_engine_install ;;
  bottle) [[ "${2:-}" == create ]] || { usage; exit 1; }; cmd_bottle_create "${3:-}" ;;
  steam)
    [[ "${2:-}" == login ]] || { usage; exit 1; }
    # Пароль в аргументах оседает в истории шелла и в ps — не принимаем.
    [[ $# -le 3 ]] || die "только логин; пароль steamcmd спросит сам"
    cmd_steam_login "${3:-}" ;;
  game)
    case "${2:-}" in
      install) cmd_game_install "${3:-}" "${4:-}" ;;
      import) cmd_game_import "${3:-}" "${4:-}" ;;
      run) shift 2; cmd_game_run "$@" ;;
      *) usage; exit 1 ;;
    esac ;;
  bridge)
    case "${2:-}" in
      build) cmd_bridge_build "${3:-}" ;;
      test) cmd_bridge_test "${3:-}" ;;
      *) usage; exit 1 ;;
    esac ;;
  cloud)
    case "${2:-}" in
      status|pull|push) cloud_sync "$2" "${3:?нужен APPID}" ;;
      *) usage; exit 1 ;;
    esac ;;
  run) shift; cmd_run "$@" ;;
  wine) shift; cmd_wine "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 1 ;;
esac
