#!/bin/sh
# Поддельный carafe-steam для тестов ядра: протокол из steam/PROTOCOL.md без сети и Steam.
# Ответы — по команде из запроса. Токен, как и у настоящего, приходит только через stdin.
[ $# -eq 0 ] || { echo "fake: аргументы не нужны" >&2; exit 2; }

echo '{"event":"ready","protocol":1,"version":"test"}'
echo 'fake: старт' >&2

ok() { printf '{"id":%s,"ok":true,"result":%s}\n' "$id" "$1"; }
fail() { printf '{"id":%s,"ok":false,"error":{"code":"%s","message":"%s"}}\n' "$id" "$1" "$2"; }
event() { printf '{"id":%s,"event":%s}\n' "$id" "$1"; }

ACCOUNT='"connected":true,"logged_in":true,"anonymous":false,"account_name":"tester","steam_id":"••••0001"'

while IFS= read -r line; do
  id=$(printf '%s\n' "$line" | sed -n 's/.*"id":\([0-9][0-9]*\).*/\1/p')
  case "$line" in
    *'"cmd":"cancel"'*) ;;
    *'"cmd":"login_qr"'*)
      event '"qr","url":"https://s.team/q/1/111"'
      event '"qr","url":"https://s.team/q/1/222"'
      event '"confirmed"'
      ok "{$ACCOUNT,\"refresh_token\":\"fake-refresh\"}" ;;
    *'"cmd":"login_token"'*)
      case "$line" in
        *'"refresh_token":"fake-refresh"'*) ok "{$ACCOUNT}" ;;
        *) fail token_invalid "Steam не пустил: AccessDenied" ;;
      esac ;;
    *'"cmd":"owned_apps"'*)
      ok '{"apps":[{"appid":3405340,"name":"Megabonk","type":"game","oslist":"windows","windows":true,"size_bytes":1100000000},{"appid":1245620,"name":"Only Mac","type":"game","oslist":"macos","windows":false,"size_bytes":null}]}' ;;
    *'"cmd":"app_info"'*)
      ok '{"appid":3405340,"name":"Megabonk","size_bytes":1100000000,"depots":[{"depotid":3405341,"name":null,"oslist":"windows","arch":"64","language":null,"size_bytes":1100000000,"manifests":{"public":"9007199254740993"},"dlc_appid":null,"install":true,"skip":null},{"depotid":3405342,"name":null,"oslist":"macos","arch":null,"language":null,"size_bytes":5,"manifests":{},"dlc_appid":null,"install":false,"skip":"не Windows"}],"branches":[{"name":"public","buildid":1,"time_updated":0,"password_required":false,"description":null}]}' ;;
    *'"cmd":"download"'*'"appid":2,'*|*'"appid":2,'*'"cmd":"download"'*)
      event '"progress","downloaded":0,"total":100'
      # Ждём отмену, как настоящий хелпер посреди загрузки.
      while IFS= read -r l2; do
        case "$l2" in *'"cmd":"cancel"'*) break ;; esac
      done
      fail cancelled "отменено" ;;
    *'"cmd":"download"'*)
      event '"depot","depotid":3405341,"manifest":"77","files":3,"total":300'
      event '"progress","downloaded":0,"total":300'
      event '"progress","downloaded":300,"total":300'
      ok '{"appid":3405340,"dir":"/tmp/carafe-test","downloaded":300,"files":3,"unchanged":0,"depots":[{"depotid":3405341,"manifest":"77"}]}' ;;
    *'"cmd":"playtime"'*)
      ok '{"games":[{"appid":3405340,"minutes":754,"minutes_2weeks":95,"last_played":1761800000}]}' ;;
    *'"cmd":"achievements"'*)
      ok '{"appid":3405340,"total":2,"unlocked":1,"achievements":[{"id":"ACH_FIRST","name":"Первая кровь","description":"Победить первого врага","icon":"https://cdn.cloudflare.steamstatic.com/steamcommunity/public/images/apps/3405340/a.jpg","icon_gray":null,"hidden":false,"unlocked":true,"unlocked_at":1761700000,"global_percent":81.5},{"id":"ACH_SECRET","name":"Тайна","description":null,"icon":null,"icon_gray":null,"hidden":true,"unlocked":false,"unlocked_at":null,"global_percent":3.2}]}' ;;
    *'"cmd":"logout"'*) ok '{"revoked":true}' ;;
    *'"cmd":"crash"'*) exit 3 ;;
    *) cmd=$(printf '%s\n' "$line" | sed -n 's/.*"cmd":"\([a-z_]*\)".*/\1/p'); fail bad_request "$cmd" ;;
  esac
done
